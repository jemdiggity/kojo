# Local runs, provider payloads, dependency checkouts, and virtual environments
/intermediate/
/.venv/
__pycache__/
*.py[cod]
.DS_Store
.env
.env.*
!.env.example
/.ruff_cache/
/configs/gauntlet-approval.json

# Run evidence, generated registry, and relocation metadata stay local.
/results/runs/
/runs/

# Legacy unnumbered chart copies are regenerated, not versioned.
/results/comparisons/20260928-dex-subset/charts/*
!/results/comparisons/20260928-dex-subset/charts/figure-*

# Publish only the current comparison; retain historical evidence locally.
/results/*
!/results/comparisons/
/results/comparisons/*
!/results/comparisons/20260928-dex-subset/
/results/comparisons/20260928-dex-subset/API_INTERRUPTION.md
/results/comparisons/20260928-dex-subset/API_PARTIAL_RESULTS.md
/results/comparisons/20260928-dex-subset/INTERRUPTION.md
/results/comparisons/20260928-dex-subset/FABLE_PLAN.md
/results/comparisons/20260928-dex-subset/PLAN.md
/results/comparisons/20260928-dex-subset/quality-circuit/
