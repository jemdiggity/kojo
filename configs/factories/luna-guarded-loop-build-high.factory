# luna-guarded-loop-high with the builder at high effort as well (Luna sessions cost about a cent at any effort; high costs wall time)
tests = tester sol61:low
build = luna6:high
fresh = check changed
qa    = qa sol61:low
fix   = luna6:high guard safe
gate  = check safe

tests -> build -> fresh
fresh -[fail, max 2, reset]-> build
fresh -> qa
qa -[fail, max 2]-> fix -> gate
gate -[fail, max 1, progress]-> fix
gate -> qa
qa -[pass]-> done
