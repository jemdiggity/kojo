# luna-guarded-loop with the fixer at high effort (Luna sessions cost about a cent at any effort)
tests = tester sol61:low
build = luna6:low
fresh = check changed
qa    = qa sol61:low
fix   = luna6:high guard safe
gate  = check safe

tests -> build -> fresh
fresh -[fail, max 2, reset]-> build
fresh -> qa
qa -[fail, max 2]-> fix -> gate
gate -[fail, max 1, progress]-> fix
gate -> qa
qa -[pass]-> done
