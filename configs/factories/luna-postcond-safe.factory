# like luna-postcond, but one gate runs smoke then the suite, a fix that breaks the program or any passing case is rolled back, and the loop stops when a fix changes nothing
tests = tester sol61:low prompt tester-postcond
build = luna6:low
fix   = luna6:low guard safe
gate  = check safe

tests -> build -> gate
gate -[fail, max 3, progress]-> fix -> gate
gate -[pass]-> done
