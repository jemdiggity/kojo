# regression-focused tester; a two-stage gate (smoke, then the accumulated suite with regressions listed first) feeds luna's fixes (max 2 + 3)
tests = tester sol61:low prompt tester-regress
build = luna6:low
fix   = luna6:low
alive = check smoke
gate  = check suite

tests -> build -> alive
alive -[fail, max 2]-> fix -> alive
alive -[pass]-> gate
gate -[fail, max 3]-> fix
gate -[pass]-> done
