# luna-postcond-safe-v2 with the builder and the fixer at high effort
tests = tester sol61:low prompt tester-postcond
build = luna6:high
fresh = check changed
fix   = luna6:high guard safe
gate  = check safe

tests -> build -> fresh
fresh -[fail, max 2, reset]-> build
fresh -> gate
gate -[fail, max 3, progress]-> fix -> gate
gate -[pass]-> done
