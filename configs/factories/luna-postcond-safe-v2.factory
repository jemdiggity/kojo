# luna-postcond-safe plus a bail-out reroll: a build that changed nothing is redone (max 2) before the smoke+suite gate; the stricter-but-sane guard and the progress arrow stay
tests = tester sol61:low prompt tester-postcond
build = luna6:low
fresh = check changed
fix   = luna6:low guard safe
gate  = check safe

tests -> build -> fresh
fresh -[fail, max 2, reset]-> build
fresh -> gate
gate -[fail, max 3, progress]-> fix -> gate
gate -[pass]-> done
