# luna-postcond-safe-v2 with the bounded systematic tester (at most 40 new cases per checkpoint, suite under 1 MB, no generated grids)
tests = tester sol61:low prompt tester-tail-v2
build = luna6:low
fresh = check changed
fix   = luna6:low guard safe
gate  = check safe

tests -> build -> fresh
fresh -[fail, max 2, reset]-> build
fresh -> gate
gate -[fail, max 3, progress]-> fix -> gate
gate -[pass]-> done
